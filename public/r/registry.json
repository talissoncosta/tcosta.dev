{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ui-lab",
  "homepage": "https://example.com",
  "items": [
    {
      "name": "toast",
      "type": "registry:component",
      "title": "Toast",
      "description": "Stacked toasts with hover-to-expand, swipe to dismiss, pausing timers and promise toasts.",
      "dependencies": ["motion"],
      "files": [
        {
          "path": "src/registry/toast/toast.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "switch",
      "type": "registry:component",
      "title": "Switch",
      "description": "Springy, draggable switch with async (optimistic/pessimistic) changes, shake-on-error, icons, custom color and native form support.",
      "dependencies": ["motion", "class-variance-authority"],
      "files": [
        {
          "path": "src/registry/switch/index.ts",
          "type": "registry:component",
          "target": "components/switch/index.ts"
        },
        {
          "path": "src/registry/switch/switch.tsx",
          "type": "registry:component",
          "target": "components/switch/switch.tsx"
        },
        {
          "path": "src/registry/switch/switch-thumb.tsx",
          "type": "registry:component",
          "target": "components/switch/switch-thumb.tsx"
        },
        {
          "path": "src/registry/switch/switch-input.tsx",
          "type": "registry:component",
          "target": "components/switch/switch-input.tsx"
        },
        {
          "path": "src/registry/switch/use-switch-state.ts",
          "type": "registry:component",
          "target": "components/switch/use-switch-state.ts"
        },
        {
          "path": "src/registry/switch/use-thumb-drag.ts",
          "type": "registry:component",
          "target": "components/switch/use-thumb-drag.ts"
        },
        {
          "path": "src/registry/switch/variants.ts",
          "type": "registry:component",
          "target": "components/switch/variants.ts"
        },
        {
          "path": "src/registry/switch/spinner.tsx",
          "type": "registry:component",
          "target": "components/switch/spinner.tsx"
        }
      ],
      "registryDependencies": ["utils"]
    },
    {
      "name": "switch-css",
      "type": "registry:component",
      "title": "Switch (CSS-only)",
      "description": "The same switch with zero JS animation \u2014 CSS transitions only.",
      "files": [
        {
          "path": "src/registry/switch-css/switch-css.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "copy-button",
      "type": "registry:component",
      "title": "Copy Button",
      "description": "Icon morphs from copy to check with a blur-scale crossfade, then the check draws itself.",
      "dependencies": ["motion"],
      "files": [
        {
          "path": "src/registry/copy-button/copy-button.tsx",
          "type": "registry:component",
          "target": "components/copy-button/copy-button.tsx"
        },
        {
          "path": "src/registry/copy-button/icons.tsx",
          "type": "registry:component",
          "target": "components/copy-button/icons.tsx"
        },
        {
          "path": "src/registry/copy-button/use-copy-to-clipboard.ts",
          "type": "registry:component",
          "target": "components/copy-button/use-copy-to-clipboard.ts"
        }
      ],
      "registryDependencies": ["utils"]
    },
    {
      "name": "animated-tabs",
      "type": "registry:component",
      "title": "Animated Tabs",
      "description": "Compound tabs (Tabs, TabsList, TabsTrigger, TabsContent) whose active pill slides between items, with the WAI-ARIA keyboard pattern.",
      "dependencies": ["motion"],
      "files": [
        {
          "path": "src/registry/animated-tabs/index.ts",
          "type": "registry:component",
          "target": "components/animated-tabs/index.ts"
        },
        {
          "path": "src/registry/animated-tabs/tabs.tsx",
          "type": "registry:component",
          "target": "components/animated-tabs/tabs.tsx"
        },
        {
          "path": "src/registry/animated-tabs/tabs-list.tsx",
          "type": "registry:component",
          "target": "components/animated-tabs/tabs-list.tsx"
        },
        {
          "path": "src/registry/animated-tabs/tabs-trigger.tsx",
          "type": "registry:component",
          "target": "components/animated-tabs/tabs-trigger.tsx"
        },
        {
          "path": "src/registry/animated-tabs/tabs-content.tsx",
          "type": "registry:component",
          "target": "components/animated-tabs/tabs-content.tsx"
        },
        {
          "path": "src/registry/animated-tabs/tabs-context.ts",
          "type": "registry:component",
          "target": "components/animated-tabs/tabs-context.ts"
        },
        {
          "path": "src/registry/animated-tabs/use-tabs-keyboard.ts",
          "type": "registry:component",
          "target": "components/animated-tabs/use-tabs-keyboard.ts"
        }
      ],
      "registryDependencies": ["utils"]
    }
  ]
}
