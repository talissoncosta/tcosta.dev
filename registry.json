    {
      "name": "theme-toggle",
      "type": "registry:component",
      "title": "Theme Toggle",
      "description": "Light/dark switch where the new theme grows in a circle from the click (View Transitions API), with a sun/moon morph. Needs next-themes with attribute=\"class\".",
      "dependencies": ["class-variance-authority", "next-themes"],
      "registryDependencies": ["utils", "https://tcosta.dev/r/icon-button.json"],
      "files": [
        {
          "path": "src/registry/theme-toggle/index.ts",
          "type": "registry:component",
          "target": "components/theme-toggle/index.ts"
