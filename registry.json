{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ui-lab",
  "homepage": "https://example.com",
  "items": [
    {
      "name": "toast",
      "type": "registry:component",
      "title": "Toast",
      "description": "Stacked toasts with hover-to-expand, swipe to dismiss, pausing timers and promise toasts.",
      "dependencies": [
        "motion"
      ],
      "files": [
        {
          "path": "src/registry/toast/toast.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "switch",
      "type": "registry:component",
      "title": "Switch",
      "description": "Springy, draggable switch with async (optimistic/pessimistic) changes, shake-on-error, icons, custom color and native form support.",
      "dependencies": [
        "motion"
      ],
      "files": [
        {
          "path": "src/registry/switch/switch.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "switch-css",
      "type": "registry:component",
      "title": "Switch (CSS-only)",
      "description": "The same switch with zero JS animation \u2014 CSS transitions only.",
      "files": [
        {
          "path": "src/registry/switch-css/switch-css.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "copy-button",
      "type": "registry:component",
      "title": "Copy Button",
      "description": "Icon morphs from copy to check with a blur-scale crossfade, then the check draws itself.",
      "dependencies": [
        "motion"
      ],
      "files": [
        {
          "path": "src/registry/copy-button/copy-button.tsx",
          "type": "registry:component",
          "target": "components/copy-button/copy-button.tsx"
        },
        {
          "path": "src/registry/copy-button/icons.tsx",
          "type": "registry:component",
          "target": "components/copy-button/icons.tsx"
        },
        {
          "path": "src/registry/copy-button/use-copy-to-clipboard.ts",
          "type": "registry:component",
          "target": "components/copy-button/use-copy-to-clipboard.ts"
        }
      ],
      "registryDependencies": [
        "utils"
      ]
    },
    {
      "name": "animated-tabs",
      "type": "registry:component",
      "title": "Animated Tabs",
      "description": "Segmented tabs with a pill that slides between items using a shared layout animation.",
      "dependencies": [
        "motion"
      ],
      "files": [
        {
          "path": "src/registry/animated-tabs/animated-tabs.tsx",
          "type": "registry:component"
        }
      ]
