          "target": "components/theme-toggle/use-theme-transition.ts"
        },
        {
          "path": "src/registry/theme-toggle/icons.tsx",
          "type": "registry:component",
          "target": "components/theme-toggle/icons.tsx"
        }
      ],
      "css": {
        "::view-transition-old(root), ::view-transition-new(root)": {
          "animation": "none",
          "mix-blend-mode": "normal"
        }
      }
    },
